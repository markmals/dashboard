{
    "files": [],
    "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.cloudflare.json" }],
    "compilerOptions": {
        "checkJs": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "~/*": ["./app/*"],
            "@tailwindcss/ui": ["app/tailwind-ui/index.ts"],
            "@tailwindcss/ui/*": ["app/tailwind-ui/*"]
        },
        "rootDirs": [".", "./.react-router/types"],
        "allowImportingTsExtensions": true
    }
}
