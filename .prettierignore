# === Languages supported by Biome ===

# JavaScript / TypeScript family
*.js
*.mjs
*.cjs
# *.jsx # need to format for tailwind class sorter
*.ts
# *.tsx # need to format for tailwind class sorter

# JSON / JSONC
*.json
*.jsonc

# Restore exceptions (Prettier should *format* these)
!package.json

# Stylesheets
*.css

# GraphQL
*.graphql
*.gql

# GritQL
*.grit

# --- Project directories Prettier should never touch ---
node_modules/
dist/
build/
coverage/
.cache/
.temp/
.tmp/
