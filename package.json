{
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "react-router dev --host",
        "format": "prettier -w .",
        "build": "react-router build",
        "preview": "npm run build && vite preview",
        "deploy": "npm run build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "typecheck": "npm run cf-typegen && react-router typegen && tsgo --noEmit",
        "postinstall": "npm run cf-typegen",
        "create-markdown": "tsx ./scripts/createMarkdownFiles.ts"
    },
    "dependencies": {
        "@cloudflare/vite-plugin": "^1.0.0",
        "@headlessui/react": "^2.1.8",
        "@heroicons/react": "^2.1.3",
        "@react-router/fs-routes": "7.7.1",
        "@react-router/node": "7.7.1",
        "@react-router/serve": "7.7.1",
        "@std/path": "npm:@jsr/std__path@^1.0.6",
        "@std/yaml": "npm:@jsr/std__yaml@^1.0.5",
        "@tailwindcss/vite": "^4.1.11",
        "clsx": "^2.1.1",
        "framer-motion": "^11.2.10",
        "isbot": "^4.1.0",
        "marked": "^14.1.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router": "7.7.1",
        "zod": "^3.23.8",
        "zod-to-json-schema": "^3.23.3"
    },
    "devDependencies": {
        "@react-router/dev": "7.7.1",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@types/node": "^20",
        "@types/react": "^18.2.20",
        "@types/react-dom": "^18.2.7",
        "@typescript/native-preview": "latest",
        "postcss": "^8.4.38",
        "prettier": "^3.3.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4.1.11",
        "tsx": "^4.19.1",
        "vite": "^6.0.0",
        "vite-tsconfig-paths": "^5.0.1",
        "wrangler": "^4.13.2"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "arrowParens": "avoid",
        "singleQuote": false,
        "semi": false,
        "plugins": [
            "prettier-plugin-tailwindcss"
        ]
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
