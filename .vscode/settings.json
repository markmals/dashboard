{
    "prettier.enable": true,

    "eslint.enable": true,
    "eslint.codeActionsOnSave.mode": "problems",
    "eslint.options": {
        "cache": true,
        "cacheLocation": "node_modules/eslint/.eslintcache"
    },

    "biome.enabled": false,
    "dprint.experimentalLsp": false,
    "deno.enable": false,

    "editor.codeActionsOnSave": {
        "source.fixAll.ts": "explicit",
        "source.fixAll.eslint": "explicit"
    },

    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,

    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[tsx]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.css": "$(capture).css.map, $(capture).*.css",
        ".env": "*.env, .env.*, .envrc, env.d.ts",
        "package.json": ".github*, .npmrc, .vscode*, eslint.config.*, mise.toml, pnpm-*.yaml, prettier.config.*, tsconfig.*, wrangler.toml, wrangler.json*, workspace.json",
        "readme*": "agent*, authors, backers*, changelog*, citation*, claude*, code_of_conduct*, codeowners, contributing*, contributors, copying, credits, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors*",
        "vite.config.*": "drizzle.config.*, react-router.config.*, vitest.config.*, *.plugin.ts"
    },
    "files.exclude": {
        ".react-router": true,
        ".wrangler": true,
        ".claude": true,
        // "build": true,
        // "dist": true,
        "worker-configuration.d.ts": true
    },

    "tailwindCSS.classAttributes": ["className"],
    "tailwindCSS.classFunctions": ["cva", "cx", "clsx"],

    "todohighlight.keywords": [
        "MARK:",
        {
            "text": "FIXME:",
            "backgroundColor": "#F14848"
        },
        {
            "text": "TODO:",
            "backgroundColor": "#3593FF"
        }
    ],
    "todohighlight.defaultStyle": {
        "backgroundColor": "#434B54",
        "color": "#fff",
        "borderRadius": "2px"
    },

    "debug.javascript.defaultRuntimeExecutable": {
        "pwa-node": "/Users/orion/.local/share/mise/shims/node"
    }
}
